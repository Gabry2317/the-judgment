# Copia questo file in ".env" e compila i valori.
# Kitab lo fa automaticamente durante l'installazione guidata.

# Porta su cui ascolta il server Node.js (Kitab apre questa porta su
# firewall e router via UPnP).
PORT=3000

# Chiave API di Groq (https://console.groq.com/keys) usata dal giudice AI.
GROQ_API_KEY=

# Modello Groq da usare per il giudice AI. Controlla su
# https://console.groq.com/docs/models quali modelli sono disponibili
# oggi: i nomi dei modelli Groq cambiano nel tempo.
GROQ_MODEL=llama-3.3-70b-versatile

# Origini consentite per le connessioni Socket.IO/CORS, separate da virgola.
# Metti qui l'indirizzo del tuo sito GitHub Pages, es:
# https://tuonome.github.io
# Usa "*" solo per test in locale, mai in produzione.
ALLOWED_ORIGIN=*

# Numero massimo di giocatori per lobby.
MAX_PLAYERS_PER_LOBBY=12

# Numero minimo di giocatori richiesti per poter depositare un'accusa
# (serve almeno un accusatore + un potenziale imputato).
MIN_PLAYERS_FOR_TRIAL=2

# --- Cloudflare Tunnel (opzionale, configurato da Kitab) --------------------
# Se usi "sudo bash kitab/kitab.sh install" e attivi il tunnel, queste
# variabili permettono la pubblicazione automatica dell'indirizzo generato
# su un Gist GitHub pubblico, così il client lo scopre da solo.
# Vedi kitab/README.md per come crearli.
# CLOUDFLARE_GIST_ID=
# CLOUDFLARE_GIST_TOKEN=
# CLOUDFLARE_GIST_FILENAME=judgement-server.json
