[Unit]
Description=The Judgement - server multiplayer (tribunale virtuale)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStartPre=-/usr/bin/env bash __INSTALL_DIR__/kitab/upnp-map.sh
ExecStart=/usr/bin/node __INSTALL_DIR__/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Piccolo indurimento di base (non blocca UPnP/rete uscente, necessaria
# per chiamare le API Groq e per la mappatura del router).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
